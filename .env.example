# ============================================================
# DealBursa — Production .env for Oracle Cloud / Docker
# העתיקו לקובץ בשם .env ומלאו את המפתחות האמיתיים.
# ============================================================

# --- Core ---
# Docker Compose מגדיר Postgres אוטומטית — אל תשנו את זה.
DATABASE_URL=postgresql://dealbursa:dealbursa@db:5432/dealbursa
REDIS_URL=redis://redis:6379/0
# הדומיין שלכם (חובה HTTPS ב-production)
SITE_URL=https://yourdomain.com
ENV=production

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXX). Empty = disabled.
GOOGLE_ANALYTICS_ID=
# Dedicated token for the scheduled product-discovery cron (/api/cron/discovery).
# Empty = endpoint disabled. Keep this OUT of the repo - set it as a secret.
CRON_SECRET=

# --- AI (Gemini) ---
# חובה! מקבלים בחינם: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- AliExpress Affiliate ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# --- Amazon Associates (PA-API) ---
AMAZON_PARTNER_TAG=
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_HOST=webservices.amazon.com

# --- eBay ---
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_CAMPAIGN_ID=

# --- Temu ---
TEMU_AFFILIATE_ID=

# --- Awin ---
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=

# --- CJ Affiliate ---
CJ_API_TOKEN=
CJ_COMPANY_ID=

# --- Rakuten Advertising ---
RAKUTEN_CLIENT_ID=
RAKUTEN_CLIENT_SECRET=
RAKUTEN_ACCOUNT_ID=

# --- 17TRACK ---
SEVENTEEN_TRACK_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Web Push (VAPID) ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@yourdomain.com

# --- Security ---
ADMIN_EMAIL=you@example.com
TEAM_EMAILS=support@you.com
ADMIN_SECRET_KEY=12345
SESSION_SECRET_KEY=change_me_please_session_secret
ADMIN_SESSION_HOURS=24
DEFAULT_AFFILIATE_REF=site
IP_LOOKUP_TIMEOUT=3

# --- SMTP (Brevo — 300 מיילים/יום חינם) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME=DealBursa

# --- Instagram ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Docker / Oracle Cloud (לא לגעת) ---
POSTGRES_USER=dealbursa
POSTGRES_PASSWORD=dealbursa
POSTGRES_DB=dealbursa
MEILI_MASTER_KEY=dealbursa-meili-master-key-change-me
WEB_CONCURRENCY=4
