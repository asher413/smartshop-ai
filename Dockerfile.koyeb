# =============================================================================
# SmartShop AI — Koyeb Lightweight Dockerfile (fits in 512 MB free tier)
#
# No Playwright/Chromium (would OOM in 512MB)
# No ChromaDB (uses SQLite-in-WAL or external Postgres)
# No Redis (in-memory fallback)
# =============================================================================

FROM python:3.11-slim

WORKDIR /srv

# Only essential system deps (no Chromium)
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Copy only what's needed
COPY requirements.txt .

# Install WITHOUT Playwright and ChromaDB heavy deps
RUN pip install --no-cache-dir \
    fastapi==0.115.0 \
    uvicorn[standard]==0.30.6 \
    jinja2==3.1.4 \
    sqlalchemy==2.0.34 \
    psycopg2-binary==2.9.9 \
    python-dotenv==1.0.1 \
    pydantic-settings==2.5.2 \
    beautifulsoup4==4.12.3 \
    requests==2.32.3 \
    rq==1.16.2 \
    apscheduler==3.10.4 \
    python-multipart==0.0.9 \
    tenacity==8.5.0 \
    passlib[bcrypt]==1.7.4 \
    bcrypt==4.0.1 \
    itsdangerous==2.2.0 \
    slowapi==0.1.9 \
    gunicorn==23.0.0 \
    authlib==1.3.2 \
    httpx==0.27.2 \
    Pillow>=10.0 \
    meilisearch==0.31.0 \
    supervisor==4.2.5

# LangChain/Google optional but small enough
RUN pip install --no-cache-dir \
    langchain-google-genai==2.0.1 \
    langchain-core==0.3.9

# ChromaDB removed — too heavy. Semantic search will fall back to DB queries.

COPY . .
RUN mkdir -p /srv/data

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz')" || exit 1

# Use gunicorn with 1 worker (512MB can't handle more)
CMD ["sh", "-c", "\
    exec gunicorn app.api.main:app \
        -k uvicorn.workers.UvicornWorker \
        -w 1 \
        -b 0.0.0.0:8000 \
        --timeout 30 \
        --graceful-timeout 15 \
        --access-logfile - \
        --error-logfile -"]
